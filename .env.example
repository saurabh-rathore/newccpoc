# --- PostgreSQL Database Configuration ---
POSTGRES_DB=ai_call_center
POSTGRES_USER=admin
POSTGRES_PASSWORD=securepassword

# --- Asterisk ARI Configuration ---
# These credentials are used by the AI Voice Gateway to connect to Asterisk's ARI.
# They are also passed to the Asterisk container to configure ari.conf.
ASTERISK_USER=ari_user
ASTERISK_PASSWORD=ari_password

# --- Other Service Configurations ---
# Add any other environment variables your services might need below.
